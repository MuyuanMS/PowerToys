{
  "configVersion": 3,
  "entries": [
    {
      "fuzzer": {
        "$type": "libfuzzerDotNet",
        "dll": "ThreeMfThumbnailProvider.FuzzTests.dll",
        "class": "ThreeMfThumbnailProvider.FuzzTests.FuzzTests",
        "method": "FuzzGetThumbnail",
        "FuzzingTargetBinaries": [
          "PowerToys.ThreeMfThumbnailProvider.dll"
        ]
      },
      "adoTemplate": {
        // supply the values appropriate to your
        // project, where bugs will be filed
        "org": "microsoft",
        "project": "OS",
        "AssignedTo": "PowerToys@microsoft.com",
        "AreaPath": "OS\\Windows Client and Services\\WinPD\\DFX-Developer Fundamentals and Experiences\\DEFT\\SALT",
        "IterationPath": "OS\\Future"
      },
      "jobNotificationEmail": "PowerToys@microsoft.com",
      "skip": false,
      "rebootAfterSetup": false,
      "oneFuzzJobs": [
        // at least one job is required
        {
          "projectName": "ThreeMfThumbnailProvider",
          "targetName": "ThreeMfThumbnailProvider-dotnet-fuzzer-GetThumbnail"
        }
      ],
      "jobDependencies": [
        // this should contain, at minimum,
        // the DLL and PDB files
        // you will need to add any other files required
        // (globs are supported)
        "ThreeMfThumbnailProvider.FuzzTests.dll",
        "ThreeMfThumbnailProvider.FuzzTests.pdb",
        "PowerToys.ThreeMfThumbnailProvider.dll",
        // runtime dependencies of the provider assembly; without these the
        // fuzz target fails assembly resolution when it reaches mesh
        // rendering (DefaultMaterialColor / HelixToolkit) and returns early
        // instead of exercising model parsing and rendering.
        "PowerToys.Settings.UI.Lib.dll",
        "PowerToys.PreviewHandlerCommon.dll",
        "PowerToys.GPOWrapper.dll",
        "PowerToys.ManagedCommon.dll",
        "PowerToys.Interop.dll",
        "HelixToolkit.dll",
        "HelixToolkit.Core.Wpf.dll",
        "Microsoft.Windows.SDK.NET.dll",
        "WinRT.Runtime.dll"
      ]
    }
  ]
}
