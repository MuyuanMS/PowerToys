<local:NavigablePage
    x:Class="Microsoft.PowerToys.Settings.UI.Views.ScreenTranslatorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.PowerToys.Settings.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Microsoft.PowerToys.Settings.UI.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tkcontrols="using:CommunityToolkit.WinUI.Controls"
    xmlns:ui="using:CommunityToolkit.WinUI"
    xmlns:views="using:Microsoft.PowerToys.Settings.UI.Views"
    AutomationProperties.LandmarkType="Main"
    mc:Ignorable="d">

    <controls:SettingsPageControl x:Uid="ScreenTranslator" ModuleImageSource="ms-appx:///Assets/Settings/Modules/TextExtractor.png">
        <controls:SettingsPageControl.ModuleContent>
            <StackPanel
                ChildrenTransitions="{StaticResource SettingsCardsAnimations}"
                Orientation="Vertical"
                Spacing="2">

                <!-- Enable Screen Translator -->
                <controls:GPOInfoControl ShowWarning="{x:Bind ViewModel.IsEnabledGpoConfigured, Mode=OneWay}">
                    <tkcontrols:SettingsCard
                        Name="ScreenTranslatorEnableToggleControlHeaderText"
                        x:Uid="ScreenTranslator_EnableToggleControl_HeaderText"
                        HeaderIcon="{ui:BitmapIcon Source=/Assets/Settings/Icons/TextExtractor.png}">
                        <ToggleSwitch
                            x:Uid="ToggleSwitch"
                            AutomationProperties.AutomationId="EnableScreenTranslatorToggleSwitch"
                            AutomationProperties.Name="Enable Screen Translator"
                            IsOn="{x:Bind ViewModel.IsEnabled, Mode=TwoWay}" />
                    </tkcontrols:SettingsCard>
                </controls:GPOInfoControl>

                <!-- Activation Shortcut -->
                <controls:SettingsGroup x:Uid="Shortcut" IsEnabled="{x:Bind ViewModel.IsEnabled, Mode=OneWay}">
                    <tkcontrols:SettingsCard
                        Name="ScreenTranslatorActivationShortcut"
                        x:Uid="Activation_Shortcut"
                        HeaderIcon="{ui:FontIcon Glyph=&#xEDA7;}">
                        <controls:ShortcutControl
                            MinWidth="{StaticResource SettingActionControlMinWidth}"
                            AutomationProperties.AutomationId="ScreenTranslatorActivationShortcutControl"
                            AutomationProperties.Name="Screen Translator Activation Shortcut"
                            HotkeySettings="{x:Bind Path=ViewModel.ActivationShortcut, Mode=TwoWay}" />
                    </tkcontrols:SettingsCard>
                    <tkcontrols:SettingsCard
                        Header="Translate Current Screen"
                        Description="Immediately capture and translate the monitor containing the foreground application.">
                        <controls:ShortcutControl
                            MinWidth="{StaticResource SettingActionControlMinWidth}"
                            AutomationProperties.AutomationId="ScreenTranslatorCurrentScreenShortcutControl"
                            AutomationProperties.Name="Translate Current Screen Shortcut"
                            HotkeySettings="{x:Bind Path=ViewModel.CurrentScreenShortcut, Mode=TwoWay}" />
                    </tkcontrols:SettingsCard>
                    <tkcontrols:SettingsCard
                        Header="Translate Active Application"
                        Description="Immediately capture and translate the current foreground application window.">
                        <controls:ShortcutControl
                            MinWidth="{StaticResource SettingActionControlMinWidth}"
                            AutomationProperties.AutomationId="ScreenTranslatorActiveWindowShortcutControl"
                            AutomationProperties.Name="Translate Active Application Shortcut"
                            HotkeySettings="{x:Bind Path=ViewModel.ActiveWindowShortcut, Mode=TwoWay}" />
                    </tkcontrols:SettingsCard>
                </controls:SettingsGroup>

                <controls:SettingsGroup Header="Overlay Appearance" IsEnabled="{x:Bind ViewModel.IsEnabled, Mode=OneWay}">
                    <tkcontrols:SettingsCard
                        Header="Freeze captured content"
                        Description="Display the captured screenshot behind translations so changing source content does not show through the overlay.">
                        <ToggleSwitch
                            AutomationProperties.AutomationId="ScreenTranslatorFreezeCapturedContentToggleSwitch"
                            AutomationProperties.Name="Freeze captured content"
                            IsOn="{x:Bind ViewModel.FreezeCapturedContent, Mode=TwoWay}" />
                    </tkcontrols:SettingsCard>
                </controls:SettingsGroup>

                <!-- Language Configuration -->
                <controls:SettingsGroup x:Uid="ScreenTranslator_LanguageGroup" Header="Language Settings" IsEnabled="{x:Bind ViewModel.IsEnabled, Mode=OneWay}">
                    <InfoBar
                        x:Uid="ScreenTranslator_OcrLanguageNotice"
                        IsClosable="False"
                        IsOpen="True"
                        Severity="Informational"
                        Title="OCR Language Support"
                        Message="Windows OCR requires the corresponding Windows language pack installed. Screen resolution, fonts, vertical text, and protected overlays may affect recognition accuracy." />

                    <tkcontrols:SettingsCard
                        Header="OCR Provider"
                        Description="Choose local OCR or Azure AI Vision OCR for improved recognition and geometry.">
                        <ComboBox
                            MinWidth="{StaticResource SettingActionControlMinWidth}"
                            AutomationProperties.AutomationId="ScreenTranslatorOcrProviderComboBox"
                            AutomationProperties.Name="OCR Provider"
                            ItemsSource="{x:Bind Path=ViewModel.AvailableOcrProviders, Mode=OneWay}"
                            SelectedIndex="{x:Bind Path=ViewModel.SelectedOcrProviderIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </tkcontrols:SettingsCard>

                    <tkcontrols:SettingsExpander
                        Header="Azure AI Vision OCR Configuration"
                        Description="Send the captured image to Azure AI Vision Image Analysis Read OCR."
                        HeaderIcon="{ui:FontIcon Glyph=&#xE774;}"
                        IsExpanded="{x:Bind ViewModel.IsAzureVisionOcrSelected, Mode=OneWay}"
                        Visibility="{x:Bind views:ScreenTranslatorPage.BoolToVisibility(ViewModel.IsAzureVisionOcrSelected), Mode=OneWay}">
                        <tkcontrols:SettingsExpander.Items>
                            <tkcontrols:SettingsCard
                                Header="Azure Vision Endpoint"
                                Description="Use the endpoint of your Azure AI Vision resource.">
                                <TextBox
                                    MinWidth="350"
                                    AutomationProperties.AutomationId="ScreenTranslatorAzureVisionEndpointTextBox"
                                    AutomationProperties.Name="Azure Vision Endpoint"
                                    Text="{x:Bind ViewModel.AzureVisionEndpoint, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </tkcontrols:SettingsCard>
                            <tkcontrols:SettingsCard
                                Header="Azure Vision Subscription Key"
                                Description="After Save, this field is cleared and the key remains stored in Windows Credential Vault.">
                                <StackPanel Spacing="8">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="260" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <PasswordBox
                                            x:Name="AzureVisionApiKeyPasswordBox"
                                            AutomationProperties.AutomationId="ScreenTranslatorAzureVisionApiKeyPasswordBox"
                                            AutomationProperties.Name="Azure Vision Subscription Key"
                                            PlaceholderText="Enter subscription key" />
                                        <Button
                                            Grid.Column="1"
                                            AutomationProperties.AutomationId="ScreenTranslatorSaveAzureVisionApiKeyButton"
                                            AutomationProperties.Name="Save Azure Vision Key"
                                            Click="SaveAzureVisionApiKey_Click"
                                            Content="Save"
                                            Style="{StaticResource AccentButtonStyle}" />
                                        <Button
                                            Grid.Column="2"
                                            AutomationProperties.AutomationId="ScreenTranslatorClearAzureVisionApiKeyButton"
                                            AutomationProperties.Name="Clear Azure Vision Key"
                                            Click="ClearAzureVisionApiKey_Click"
                                            Content="Clear" />
                                    </Grid>
                                    <InfoBar
                                        x:Name="AzureVisionApiKeyStatusInfoBar"
                                        AutomationProperties.AutomationId="ScreenTranslatorAzureVisionApiKeyStatusInfoBar"
                                        IsClosable="False"
                                        IsOpen="False" />
                                </StackPanel>
                            </tkcontrols:SettingsCard>
                        </tkcontrols:SettingsExpander.Items>
                    </tkcontrols:SettingsExpander>

                    <tkcontrols:SettingsCard
                        x:Uid="ScreenTranslator_SourceLanguageCard"
                        Header="OCR / Source Language"
                        Description="Select the language of on-screen text to recognize.">
                        <ComboBox
                            x:Name="SourceLanguageComboBox"
                            MinWidth="{StaticResource SettingActionControlMinWidth}"
                            AutomationProperties.AutomationId="ScreenTranslatorSourceLanguageComboBox"
                            AutomationProperties.Name="Source Language"
                            ItemsSource="{x:Bind Path=ViewModel.AvailableSourceLanguages, Mode=OneWay}"
                            SelectedIndex="{x:Bind Path=ViewModel.SourceLanguageIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </tkcontrols:SettingsCard>

                    <tkcontrols:SettingsCard
                        x:Uid="ScreenTranslator_TargetLanguageCard"
                        Header="Target Language"
                        Description="Select the language into which detected text should be translated.">
                        <ComboBox
                            x:Name="TargetLanguageComboBox"
                            MinWidth="{StaticResource SettingActionControlMinWidth}"
                            AutomationProperties.AutomationId="ScreenTranslatorTargetLanguageComboBox"
                            AutomationProperties.Name="Target Language"
                            ItemsSource="{x:Bind Path=ViewModel.AvailableTargetLanguages, Mode=OneWay}"
                            SelectedIndex="{x:Bind Path=ViewModel.TargetLanguageIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </tkcontrols:SettingsCard>
                </controls:SettingsGroup>

                <!-- Translation Provider Settings -->
                <controls:SettingsGroup x:Uid="ScreenTranslator_ProviderGroup" Header="Translation Provider" IsEnabled="{x:Bind ViewModel.IsEnabled, Mode=OneWay}">
                    <tkcontrols:SettingsCard
                        x:Uid="ScreenTranslator_ProviderCard"
                        Header="Translation Service"
                        Description="Choose how detected text is translated.">
                        <ComboBox
                            x:Name="ProviderComboBox"
                            MinWidth="{StaticResource SettingActionControlMinWidth}"
                            AutomationProperties.AutomationId="ScreenTranslatorProviderComboBox"
                            AutomationProperties.Name="Translation Service Provider"
                            ItemsSource="{x:Bind Path=ViewModel.AvailableProviders, Mode=OneWay}"
                            SelectedIndex="{x:Bind Path=ViewModel.SelectedProviderIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </tkcontrols:SettingsCard>

                    <!-- Azure AI Translator Settings -->
                    <tkcontrols:SettingsExpander
                        x:Uid="ScreenTranslator_AzureExpander"
                        Header="Azure AI Translator Configuration"
                        Description="Configure Microsoft Azure Cognitive Services Translator v3 endpoint and credentials."
                        HeaderIcon="{ui:FontIcon Glyph=&#xEB55;}"
                        IsExpanded="{x:Bind ViewModel.IsAzureProviderSelected, Mode=OneWay}"
                        Visibility="{x:Bind views:ScreenTranslatorPage.BoolToVisibility(ViewModel.IsAzureProviderSelected), Mode=OneWay}">
                        <tkcontrols:SettingsExpander.Items>
                            <tkcontrols:SettingsCard
                                x:Uid="ScreenTranslator_AzureEndpointCard"
                                Header="Azure Endpoint URL"
                                Description="Default: https://api.cognitive.microsofttranslator.com">
                                <TextBox
                                    MinWidth="350"
                                    AutomationProperties.AutomationId="ScreenTranslatorAzureEndpointTextBox"
                                    AutomationProperties.Name="Azure Endpoint URL"
                                    Text="{x:Bind ViewModel.AzureEndpoint, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </tkcontrols:SettingsCard>
                            <tkcontrols:SettingsCard
                                x:Uid="ScreenTranslator_AzureRegionCard"
                                Header="Azure Region"
                                Description="Optional resource region (e.g. eastus, westeurope, global).">
                                <TextBox
                                    MinWidth="200"
                                    AutomationProperties.AutomationId="ScreenTranslatorAzureRegionTextBox"
                                    AutomationProperties.Name="Azure Region"
                                    Text="{x:Bind ViewModel.AzureRegion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </tkcontrols:SettingsCard>
                            <tkcontrols:SettingsCard
                                x:Uid="ScreenTranslator_AzureKeyCard"
                                Header="Azure Subscription Key"
                                Description="After Save, this field is cleared and the key remains stored in Windows Credential Vault.">
                                <StackPanel Spacing="8">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="260" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <PasswordBox
                                            x:Name="AzureApiKeyPasswordBox"
                                            AutomationProperties.AutomationId="ScreenTranslatorAzureApiKeyPasswordBox"
                                            AutomationProperties.Name="Azure Subscription Key"
                                            PlaceholderText="Enter subscription key" />
                                        <Button
                                            x:Name="SaveAzureApiKeyButton"
                                            Grid.Column="1"
                                            AutomationProperties.AutomationId="ScreenTranslatorSaveAzureApiKeyButton"
                                            AutomationProperties.Name="Save Azure Key"
                                            Click="SaveAzureApiKey_Click"
                                            Content="Save"
                                            Style="{StaticResource AccentButtonStyle}" />
                                        <Button
                                            x:Name="ClearAzureApiKeyButton"
                                            Grid.Column="2"
                                            AutomationProperties.AutomationId="ScreenTranslatorClearAzureApiKeyButton"
                                            AutomationProperties.Name="Clear Azure Key"
                                            Click="ClearAzureApiKey_Click"
                                            Content="Clear" />
                                    </Grid>
                                    <InfoBar
                                        x:Name="AzureApiKeyStatusInfoBar"
                                        AutomationProperties.AutomationId="ScreenTranslatorAzureApiKeyStatusInfoBar"
                                        IsClosable="False"
                                        IsOpen="False" />
                                </StackPanel>
                            </tkcontrols:SettingsCard>
                            <tkcontrols:SettingsCard
                                Header="Connection and usage"
                                Description="Testing sends “Hello” to Azure Translator. For usage, select your Translator resource in Azure and chart TextCharactersTranslated with Sum.">
                                <StackPanel Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button
                                            x:Name="TestAzureConnectionButton"
                                            AutomationProperties.AutomationId="ScreenTranslatorTestAzureConnectionButton"
                                            AutomationProperties.Name="Test Azure Translator connection"
                                            Click="TestAzureConnectionButton_Click"
                                            Content="Test connection" />
                                        <Button
                                            AutomationProperties.AutomationId="ScreenTranslatorViewAzureUsageButton"
                                            AutomationProperties.Name="View Azure Translator usage"
                                            Click="ViewAzureUsageButton_Click"
                                            Content="View Azure usage" />
                                    </StackPanel>
                                    <InfoBar
                                        x:Name="AzureConnectionStatusInfoBar"
                                        AutomationProperties.AutomationId="ScreenTranslatorAzureConnectionStatusInfoBar"
                                        IsClosable="True"
                                        IsOpen="False" />
                                </StackPanel>
                            </tkcontrols:SettingsCard>
                        </tkcontrols:SettingsExpander.Items>
                    </tkcontrols:SettingsExpander>

                    <!-- LibreTranslate Settings -->
                    <tkcontrols:SettingsExpander
                        x:Uid="ScreenTranslator_LibreTranslateExpander"
                        Header="LibreTranslate Configuration"
                        Description="Configure LibreTranslate self-hosted or remote instance."
                        HeaderIcon="{ui:FontIcon Glyph=&#xE774;}"
                        IsExpanded="{x:Bind ViewModel.IsLibreTranslateProviderSelected, Mode=OneWay}"
                        Visibility="{x:Bind views:ScreenTranslatorPage.BoolToVisibility(ViewModel.IsLibreTranslateProviderSelected), Mode=OneWay}">
                        <tkcontrols:SettingsExpander.Items>
                            <tkcontrols:SettingsCard
                                x:Uid="ScreenTranslator_LibreTranslateEndpointCard"
                                Header="Endpoint URL"
                                Description="Local instance (e.g. http://localhost:5000) or remote HTTPS server.">
                                <TextBox
                                    MinWidth="350"
                                    AutomationProperties.AutomationId="ScreenTranslatorLibreTranslateEndpointTextBox"
                                    AutomationProperties.Name="LibreTranslate Endpoint URL"
                                    Text="{x:Bind ViewModel.LibreTranslateEndpoint, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </tkcontrols:SettingsCard>
                            <tkcontrols:SettingsCard
                                x:Uid="ScreenTranslator_LibreTranslateKeyCard"
                                Header="API Key (Optional)"
                                Description="Optional for self-hosted instances. After Save, this field is cleared and the key remains stored in Windows Credential Vault.">
                                <StackPanel Spacing="8">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="260" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <PasswordBox
                                            x:Name="LibreTranslateApiKeyPasswordBox"
                                            AutomationProperties.AutomationId="ScreenTranslatorLibreTranslateApiKeyPasswordBox"
                                            AutomationProperties.Name="LibreTranslate API Key"
                                            PlaceholderText="Optional API key" />
                                        <Button
                                            x:Name="SaveLibreTranslateApiKeyButton"
                                            Grid.Column="1"
                                            AutomationProperties.AutomationId="ScreenTranslatorSaveLibreTranslateApiKeyButton"
                                            AutomationProperties.Name="Save LibreTranslate Key"
                                            Click="SaveLibreTranslateApiKey_Click"
                                            Content="Save"
                                            Style="{StaticResource AccentButtonStyle}" />
                                        <Button
                                            x:Name="ClearLibreTranslateApiKeyButton"
                                            Grid.Column="2"
                                            AutomationProperties.AutomationId="ScreenTranslatorClearLibreTranslateApiKeyButton"
                                            AutomationProperties.Name="Clear LibreTranslate Key"
                                            Click="ClearLibreTranslateApiKey_Click"
                                            Content="Clear" />
                                    </Grid>
                                    <InfoBar
                                        x:Name="LibreTranslateApiKeyStatusInfoBar"
                                        AutomationProperties.AutomationId="ScreenTranslatorLibreTranslateApiKeyStatusInfoBar"
                                        IsClosable="False"
                                        IsOpen="False" />
                                </StackPanel>
                            </tkcontrols:SettingsCard>
                        </tkcontrols:SettingsExpander.Items>
                    </tkcontrols:SettingsExpander>

                    <tkcontrols:SettingsExpander
                        x:Uid="ScreenTranslator_AcpExpander"
                        Header="ACP Agent Configuration"
                        Description="Run an ACP-compatible agent locally for contextual translation."
                        HeaderIcon="{ui:FontIcon Glyph=&#xE756;}"
                        IsExpanded="{x:Bind ViewModel.IsAcpAgentProviderSelected, Mode=OneWay}"
                        Visibility="{x:Bind views:ScreenTranslatorPage.BoolToVisibility(ViewModel.IsAcpAgentProviderSelected), Mode=OneWay}">
                        <tkcontrols:SettingsExpander.Items>
                            <tkcontrols:SettingsCard
                                x:Uid="ScreenTranslator_AcpCommandCard"
                                Header="ACP Agent Command"
                                Description="Default uses gpt-5-mini with minimal reasoning for lower latency. The agent receives OCR text only; filesystem and terminal capabilities are not offered.">
                                <TextBox
                                    MinWidth="350"
                                    AutomationProperties.AutomationId="ScreenTranslatorAcpCommandTextBox"
                                    AutomationProperties.Name="ACP Agent Command"
                                    Text="{x:Bind ViewModel.AcpAgentCommand, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </tkcontrols:SettingsCard>
                        </tkcontrols:SettingsExpander.Items>
                    </tkcontrols:SettingsExpander>
                </controls:SettingsGroup>
            </StackPanel>
        </controls:SettingsPageControl.ModuleContent>

        <controls:SettingsPageControl.PrimaryLinks>
            <controls:PageLink x:Uid="LearnMore_ScreenTranslator" Link="https://aka.ms/PowerToysOverview_ScreenTranslator" Text="Learn more about Screen Translator" />
        </controls:SettingsPageControl.PrimaryLinks>
    </controls:SettingsPageControl>
</local:NavigablePage>
